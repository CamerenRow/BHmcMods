#     executable by: players and console
#     trigger:
#         if isConsole(sender) is true:
#             send "&aYou are console." to sender
#         else:
#             send "&aYou are a player." to sender

command /joinleavemsg:
    executable by: players and console
    trigger:
        if isConsole(sender) is true:
            send "&cThis command cannot be executed from console." to sender
        else if player is op:
            if {notifyjoinleave::%player's uuid%} is true:
                set {notifyjoinleave::%player's uuid%} to false
                send "&cJoin and leave messages for you have been turned off." to player
            else if {notifyjoinleave::%player's uuid%} is false:
                set {notifyjoinleave::%player's uuid%} to true
                send "&aJoin and leave messages for you have been turned off." to player
        else:
            noPermission(player)

on command:
    if player is op:
        if full command contains "/":
            loop all players:
                if loop-player is op:
                    send "&6Staff » &c%player% has executed a World Edit command. (/%full command%)" to player
            log "Staff » %player% has executed a World Edit command. (/%full command%)" with a severity of severe
        stop
    else:
        stop

command /backup-notify:
    executable by: console
    trigger:
        loop all players:
            if loop-player is op:
                send "&6Staff » &cThe server has been successfully saved and backed-up." to loop-player
        send "Staff » The server has been successfully saved and backed-up." to console

command /nuke:
    executable by: players and console
    trigger:
        if isConsole(sender) is true:
            send "&cThis command has been disabled." to sender
        else if player is op:
            send "&cThis command has been disabled." to player
        else:
            noPermission(sender)

command /togglepvp:
    executable by: players and console
    trigger:
        if isConsole(sender) is true:
            if {pvp} is true:
                set {pvp} to false
                send "&cPVP has been disabled." to sender
            else:
                set {pvp} to true
                send "&aPVP has been enabled." to sender
        else if player is op:
            if {pvp} is true:
                set {pvp} to false
                send "&cPVP has been disabled." to player
            else:
                set {pvp} to true
                send "&aPVP has been enabled." to player
        else:
            noPermission(sender)

on damage of player:
    if attacker is a player:
        if {pvp} is true:
            stop
        else if {pvp} is false:
            cancel event
            send "&cYou cannot attack that player as PVP has been disabled." to attacker