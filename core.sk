variables:
    {chat.muted} = false
    {block.break} = true
    {argument} = ""
    {frozen::*} = false
    {ver} = "1.1.1"
    {pvp} = true

command /clearchat:
    executable by: players and console
    trigger:
        if isConsole(sender) is true:
            loop 200 times:
                send "&r" to all players
            send "&aChat cleared by &b%sender%&a!" to all players
            send "&aChat cleared by &b%sender%&a!" to sender
        else if player has permission "clearchat.use":
            loop 200 times:
                send "&r"
            send "&aChat cleared by &b%player%&a!" to all players
        else: 
            noPermission(sender)

command /togglechat:
    executable by: players and console
    trigger:
        if isConsole(sender) is true:
            if {chat.muted} is false:
                set {chat.muted} to true
                broadcast "&cChat has been muted."
            else:
                set {chat.muted} to false
                broadcast "&aChat has been enabled."
        else if player has permission "togglechat.use":
            if {chat.muted} is false:
                set {chat.muted} to true
                broadcast "&cChat has been muted."
            else:
                set {chat.muted} to false
                broadcast "&aChat has been enabled."
        else:
            noPermission(sender)

on chat:
    if {chat.muted} is true:
        if player has permission "clearchat.bypass":
            stop
        else:
            send "&cYou cannot chat right now."
            cancel event

command /togglebreak:
    executable by: players and console
    trigger:
        if isConsole(sender) is true:
            if {block.break} is true:
                set {block.break} to false
                broadcast "&cBreaking blocks has been disabled."
            else:
                set {block.break} to true
                broadcast "&aBreaking blocks has been enabled."
        else if player has permission "togglebreak.use":
            if {block.break} is true:
                set {block.break} to false
                broadcast "&cBreaking blocks has been disabled."
            else:
                set {block.break} to true
                broadcast "&aBreaking blocks has been enabled."
        else:
            noPermission(sender)

on block break:
    if {block.break} is true:
        stop
    if {block.break} is false:
        if player has permission "togglebreak.bypass":
            stop
        else:
            send "&cYou cannot break blocks."
            cancel event

command /broadcast [<text>]:
    executable by: players and console
    trigger:
        if isConsole(sender) is true:
            if arg-1 is not set:
                send "&cUsage: /broadcast <text>" to player
                stop
            if arg-1 matches "^&[0-9a-fA-F]$":
                set {_letter} to subtext of arg-1 from 2 to 2
                send "&cmain.cpp:5:10: error: expected arg-1 to have text, got color code instead" to player
                execute console command "tellraw %player% {""text"":""\u00A0\u00A0\u00A0\u00A0broadcast &%{_letter}%;"",""color"":""yellow""}"
                execute console command "tellraw %player% {""text"":""\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0^"",""color"":""yellow""}"
                stop
            else:
                broadcast arg-1
        else if player has permission "broadcast.use":
            if arg-1 is not set:
                send "&cUsage: /broadcast <text>" to player
                stop
            if arg-1 matches "^&[0-9a-fA-F]$":
                set {_letter} to subtext of arg-1 from 2 to 2
                send "&cmain.cpp:5:10: error: expected arg-1 to have text, got color code instead" to player
                execute console command "tellraw %player% {""text"":""\u00A0\u00A0\u00A0\u00A0broadcast &%{_letter}%;"",""color"":""yellow""}"
                execute console command "tellraw %player% {""text"":""\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0\u00A0^"",""color"":""yellow""}"
                stop
            else:
                broadcast arg-1
        else:
            noPermission(sender)

command /kickall [<text>]:
    executable by: players and console
    trigger:
        if isConsole(sender) is true:
            if arg-1 is not set:
                send "&cUsage: /kickall <text>"
                stop
            else:
                kick all players due to arg-1
                stop
        else if player has permission "kickall.use":
            if arg-1 is not set:
                send "&cUsage: /kickall <text>"
                stop
            else:
                kick all players due to arg-1
                stop
        else:
            noPermission(sender)


command /disconnect [<offline player>] [<text>]:
    executable by: players and console
    trigger:
        if isConsole(sender) is true:
            if arg-1 or arg-2 is not set:
                send "&cUsage: /disconnect <player> <text>" to sender
            else:
                if arg-1 is offline:
                    send "&c%arg-1% is offline."
                else:
                    kick arg-1 due to arg-2
        else if player is an op:
            if arg-1 or arg-2 is not set:
                send "&cUsage: /disconnect <player> <text>" to sender
            else:
                if arg-1 is offline:
                    send "&c%arg-1% is offline."
                else:
                    kick arg-1 due to arg-2
        else:
            noPermission(sender)

command /cavescare [<player>]:
    executable by: players and console
    trigger:
        if isConsole(sender) is true:
            if arg-1 is not set:
                send "&cUsage: /cavescare <player>" to sender
            else:
                play sound "ambient.cave" with volume 1.0 and pitch 1.0 to arg-1
                send "&aSent cave scare to %arg-1%!" to sender
        else if player is an op:
            if arg-1 is not set:
                send "&cUsage: /cavescare <player>" to player
            else:
                play sound "ambient.cave" with volume 1.0 and pitch 1.0 to arg-1
                send "&aSent cave scare to %arg-1%!" to player
        else:
            noPermission(sender)

command /witherscare [<player>]:
    executable by: players and console
    trigger:
        if isConsole(sender) is true:
            if arg-1 is not set:
                send "&cUsage: /witherscare <player>" to sender
            else:
                send "&aSent wither scare to %arg-1%!" to sender
                play sound "entity.wither.spawn" with volume 1.0 and pitch 1.0 to arg-1
                wait 4 seconds
                play sound "entity.wither.death" with volume 1.0 and pitch 1.0 to arg-1
        else if player is an op:
            if arg-1 is not set:
                send "&cUsage: /witherscare <player>" to player
            else:
                send "&aSent wither scare to %arg-1%!" to player
                play sound "entity.wither.spawn" with volume 1.0 and pitch 1.0 to arg-1
                wait 4 seconds
                play sound "entity.wither.death" with volume 1.0 and pitch 1.0 to arg-1
        else:
            noPermission(sender)

command /enderscare [<player>]:
    executable by: players and console
    trigger:
        if isConsole(sender) is true:
            if arg-1 is not set:
                send "&cUsage: /witherscare <player>" to sender
            else:
                send "&aSent ender scare to %arg-1%!" to sender
                play sound "entity.ender_dragon.ambient" with volume 1.0 and pitch 1.0 to arg-1
                wait 2 seconds
                play sound "entity.ender_dragon.death" with volume 1.0 and pitch 1.0 to arg-1
        else if player is an op:
            if arg-1 is not set:
                send "&cUsage: /witherscare <player>" to player
            else:
                send "&aSent ender scare to %arg-1%!" to player
                play sound "entity.ender_dragon.ambient" with volume 1.0 and pitch 1.0 to arg-1
                wait 2 seconds
                play sound "entity.ender_dragon.death" with volume 1.0 and pitch 1.0 to arg-1
        else:
            noPermission(sender)
command /creeperscare [<player>]:
    executable by: players and console
    trigger:
        if isConsole(sender) is true:
            if arg-1 is not set:
                send "&cUsage: /creeperscare <player>" to sender
            else:
                send "&aSent creeper scare to %arg-1%!" to sender
                play sound "entity.creeper.primed" with volume 1.0 and pitch 1.0 to arg-1
                wait 2 seconds
                play sound "minecraft:entity.generic.explode" with volume 1.0 and pitch 1.0 to arg-1
        else if player is an op:
            if arg-1 is not set:
                send "&cUsage: /creeperscare <player>" to player
            else:
                send "&aSent creeper scare to %arg-1%!" to player
                play sound "entity.creeper.primed" with volume 1.0 and pitch 1.0 to arg-1
                wait 2 seconds
                play sound "minecraft:entity.generic.explode" with volume 1.0 and pitch 1.0 to arg-1
        else:
            noPermission(sender)

command /reload:
    executable by: players and console
    trigger:
        if isConsole(sender) is true:
            commandDisabled(sender)
        else if player is an op:
            commandDisabled(sender)
        else:
            noPermission(sender)

command /freeze [<offline player>]:
    executable by: players and console
    trigger:
        if isConsole(sender) is true:
            if arg-1 is set:
                if arg-1 is online:
                    if {frozen::%arg-1's uuid%} = false:
                        set {frozen::%arg-1's uuid%} to true
                        send "&cSuccessfully frozen %arg-1%." to sender
                    else:
                        set {frozen::%arg-1's uuid%} to false
                        send "&aSuccessfully unfrozen %arg-1%." to sender
                else:
                    send "&c%arg-1% is offline." to sender
            else:
                send "&cUsage: /freeze <player>" to sender
        else if sender has permission "freeze.use":
            if arg-1 is set:
                if arg-1 is online:
                    if arg-1 has permission "freeze.bypass":
                        if {frozen::%arg-1's uuid%} is false:
                            if player is "mathtrixx_":
                                if {frozen::%arg-1's uuid%} = false:
                                    set {frozen::%arg-1's uuid%} to true
                                    send "&cSuccessfully frozen %arg-1%." to sender
                                else:
                                    set {frozen::%arg-1's uuid%} to false
                                    send "&aSuccessfully unfrozen %arg-1%." to sender
                        else if {frozen::%arg-1's uuid%} is true:
                            set {frozen::%arg-1's uuid%} to false
                            send "&aSuccessfully unfrozen %arg-1%." to sender
                        else:
                            send "&cYou may not freeze this player." to player
                            stop
                    else:
                        if {frozen::%arg-1's uuid%} = false:
                            set {frozen::%arg-1's uuid%} to true
                            send "&cSuccessfully frozen %arg-1%." to sender
                        else:
                            set {frozen::%arg-1's uuid%} to false
                            send "&aSuccessfully unfrozen %arg-1%." to sender
                else:
                    send "&c%arg-1% is offline." to sender
            else:
                send "&cUsage: /freeze <player>" to sender
        else:
            noPermission(sender)

on join:
    if {frozen::%player's uuid%} is not set:
        set {frozen::%player's uuid%} to false
    if {notifyjoinleave::%player's uuid%} is not set:
        set {notifyjoinleave::%player's uuid%} to true

on player move:
    if {frozen::%player's uuid%} is true:
        if x-coord of event-location is not x-coord of player's location:
            set {_moved} to true
        else if y-coord of event-location is not x-coord of player's location:
            set {_moved} to true
        else if z-coord of event-location is not z-coord of player's location:
            set {_moved} to true
        
        if {_moved} is true:
            cancel event
            send "&cYou have been frozen." to player
    else:
        stop

on block break:
    if {frozen::%player's uuid%} is true:
        cancel event
    else:
        stop

on block place:
    if {frozen::%player's uuid%} is true:
        cancel event
    else:
        stop

on command:
    if {frozen::%player's uuid%} is true:
        send "&cYou may not use commands while frozen." to player
        cancel event
    else:
        stop

command /dickheads:
    executable by: players and console
    trigger:
        send "Bailyn H., Lucas H." to sender
        stop

command /help:
    trigger:
        if isConsole(sender) is true:
            send "&a----------[Core Help]----------" to sender
            send "&c/clearchat - clears the chat" to sender
            send "&c/togglechat - toggles the chat" to sender
            send "&c/togglebreak - toggles breaking blocks" to sender
            send "&c/broadcast <message> - broadcasts message" to sender
            send "&c/kickall <message> - kicks all with a message" to sender
            send "&c/disconnect <player> <message> - disconnects with message" to sender
            send "&c/cavescare <player> - plays cave sounds" to sender
            send "&c/witherscare <player> - plays wither sounds" to sender
            send "&c/enderscare <player> - plays ender dragon sounds" to sender
            send "&c/creeperscare <player> - plays creeper sounds" to sender
            send "&c/freeze <player> - freezes a player" to sender
            send "&c/core (version/reload) - check core version or reload" to sender
            send "&c/joinleavemsg - toggles the join or leave message of a player" to sender
            send "&c/togglepvp - toggles pvp" to sender
            send "&a----------[Core Help]----------" to sender
            stop
        else if player has permission "help.use":
            send "&a----------[Core Help]----------" to player
            send "&c/clearchat - clears the chat" to player
            send "&c/togglechat - toggles the chat" to player
            send "&c/togglebreak - toggles breaking blocks" to player
            send "&c/broadcast <message> - broadcasts message" to player
            send "&c/kickall <message> - kicks all with a message" to player
            send "&c/disconnect <player> <message> - disconnects with message" to player
            send "&c/cavescare <player> - plays cave sounds" to player
            send "&c/witherscare <player> - plays wither sounds" to player
            send "&c/enderscare <player> - plays ender dragon sounds" to player
            send "&c/creeperscare <player> - plays creeper sounds" to player
            send "&c/freeze <player> - freezes a player" to player
            send "&c/core (version/reload) - check core version or reload" to player
            send "&c/joinleavemsg - toggles the join or leave message of a player" to player
            send "&c/togglepvp - toggles pvp" to player
            send "&a----------[Core Help]----------" to player
            stop
        else:
            send "&cYou do not have permission to execute this command." to player
            stop

command /core [<text>]:
    trigger:
        if isConsole(sender) is true:
            if arg-1 is not set:
                send "&cUsage: /core (version/reload)" to sender
            else if arg-1 is "version":
                send "&cCore is running on v%{ver}%."
            else if arg-1 is "reload":
                execute console command "sk reload core"
                send "&aReloaded Core." to sender
            else:
                send "&cThat was not a valid selection. Use /core for help." to sender
        else if player has permission "core.use":
            if arg-1 is not set:
                send "&cUsage: /core (version/reload)" to sender
            else if arg-1 is "version":
                send "&cCore is running on v%{ver}%."
            else if arg-1 is "reload":
                execute console command "sk reload core"
                send "&aReloaded Core." to sender
            else:
                send "&cThat was not a valid selection. Use /core for help." to sender
        else:
            noPermission(sender)

function noPermission(p: player):
    send "&cYou do not have permission to execute this command." to {_p}

function isConsole(sender: commandsender) :: boolean:
    if {_sender} is console:
        return true
    else:
        return false

function commandDisabled(s: commandsender):
    send "&cThis command has been disabled." to {_s}

